{
  "manifest_version": 3,
  "minimum_chrome_version": "111",
  "name": "Phrase Highlighter for Language Reactor",
  "short_name": "Phrase Highlighter",
  "version": "1.0.0",
  "description": "Companion for Language Reactor: shows meaning cards for the current line on languagereactor.com.",
  "author": "Burak Keskin",
  "homepage_url": "https://github.com/official-burak/phrase-highlighter-for-language-reactor",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Phrase Highlighter for Language Reactor",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.languagereactor.com/*",
        "https://languagereactor.com/*"
      ],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.languagereactor.com/*",
        "https://languagereactor.com/*"
      ],
      "js": ["dist/page-hook.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.languagereactor.com/*",
        "https://languagereactor.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon16.png",
        "icons/icon32.png",
        "icons/icon48.png",
        "icons/icon128.png"
      ],
      "matches": [
        "https://www.languagereactor.com/*",
        "https://languagereactor.com/*"
      ]
    }
  ]
}
